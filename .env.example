# Copia este fichero a .env y rellena los valores. .env NO se sube al repo.

# OpenAI (obligatorio)
OPENAI_API_KEY=sk-...
# Modelo de chat: gpt-4o-mini (elegido tras medir; ver evals/COMPARATIVA-MODELOS.md)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Proveedor de embeddings: openai | ollama
EMBEDDINGS_PROVIDER=openai

# Proveedor de chat: openai | ollama. Ollama es solo para medir en local frente a
# OpenAI (paso 8.11, ver evals/COMPARATIVA-MODELOS.md); no va a producción. Requiere
# Ollama corriendo en el equipo anfitrión (no en Docker) con el modelo descargado:
#   ollama pull llama3.2:3b
CHAT_PROVIDER=openai
# CHAT_OLLAMA_MODEL=llama3.2:3b
# CHAT_OLLAMA_NUM_CTX=4096

# Base de datos (el valor por defecto solo para desarrollo local)
POSTGRES_PASSWORD=agentpilot_dev

# Clave de firma de los JWT (mín. 32 bytes). Cambiar por una aleatoria en producción.
JWT_SIGNING_KEY=clave-de-desarrollo-solo-para-local-cambiar-en-produccion-1234567890

# Sentry (opcional): DSN del proyecto para recibir errores. Vacío = desactivado.
SENTRY_DSN=

ASPNETCORE_ENVIRONMENT=Development
